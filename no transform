from airflow import DAG
from datetime import timedelta, datetime
from airflow.providers.http.sensors.http import HttpSensor
from airflow.providers.http.operators.http import HttpOperator  # Use HttpOperator
import json
from airflow.operators.python import PythonOperator
import pandas as pd

def load_data(task_instance):
    data = task_instance.xcom_pull(task_ids="extract_weather_data")
    
    # Create a DataFrame from the raw data
    df_data = pd.DataFrame([data])
    
    # Define AWS credentials
    aws_credentials = {
        "key": "",
        "secret": "",
        "token": ""
    }

    now = datetime.now()
    dt_string = now.strftime("%d%m%Y%H%M%S")
    dt_string = 'current_weather_data_portland_' + dt_string
    df_data.to_csv(f"s3://kaggle-datasets-my-team-bucket-yml/{dt_string}.csv", index=False, storage_options=aws_credentials)

default_args = {
    'owner': 'airflow',
    'depends_on_past': False,
    'start_date': datetime(2023, 1, 8),
    'email': ['myemail@domain.com'],
    'email_on_failure': False,
    'email_on_retry': False,
    'retries': 2,
    'retry_delay': timedelta(minutes=2)
}

with DAG('weather_dag',
         default_args=default_args,
         schedule_interval='@daily',
         catchup=False) as dag:

    is_weather_api_ready = HttpSensor(
        task_id='is_weather_api_ready',
        http_conn_id='weathermap_api',
        endpoint='/data/2.5/weather?q=Portland&APPID=a82d7a34412ce0409593babe7fc92c5d'
    )

    extract_weather_data = HttpOperator(
        task_id='extract_weather_data',
        http_conn_id='weathermap_api',
        endpoint='/data/2.5/weather?q=Portland&APPID=a82d7a34412ce0409593babe7fc92c5d',
        method='GET',
        response_filter=lambda r: json.loads(r.text),
        log_response=True
    )

    load_weather_data = PythonOperator(
        task_id='load_weather_data',
        python_callable=load_data
    )

    is_weather_api_ready >> extract_weather_data >> load_weather_data
